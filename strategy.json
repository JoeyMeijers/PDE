{
  "source": { "path": "sources/persons.csv" },
  "pipeline": [
    {
      "id": "add_is_adult",
      "language": "python",
      "image": "strategy-python:latest",
      "function": "add_is_adult",
      "input": "source",
      "output": "data.with_is_adult"
    },
    {
      "id": "sleep_1",
      "type": "sleep",
      "duration_ms": 1000
    },
    {
      "id": "capitalize_names",
      "language": "python",
      "image": "strategy-python:latest",
      "function": "capitalize_names",
      "input": "data.with_is_adult",
      "output": "data.names_capitalized"
    },
    {
      "id": "add_age_plus_one",
      "language": "rust",
      "image": "strategy-rust-add-age:latest",
      "input": "data.names_capitalized",
      "output": "data.age_plus_one"
    }
  ],
  "sink": {
    "path": "output/persons_processed.csv",
    "input": "data.age_plus_one"
  }
}